MERGE (m:Mod {mod_id: "TombBodyCompat"}) SET m.name = "Tomb's Player Body - [Compatibility - Vanilla+]", m.version = "", m.author = "Tomb", m.pz_version = "", m.description = "Compatibility patch adjusting Vanilla clothing meshes (and any mods that reference them) as well as some specific mod meshes to better fit the body of Tomb's Player Body Overhaul. Enable the mod, then in the Load Order place this below any mod that adds custom clothing and restart the game for it to take effect.";
