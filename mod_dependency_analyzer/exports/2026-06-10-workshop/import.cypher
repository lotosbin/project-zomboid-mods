MERGE (m:Mod {mod_id: "BanditsCreator"}) SET m.name = "Bandits Creator", m.version = "", m.author = "Slayer", m.pz_version = "", m.description = "<RED>Always make sure that you have the newest version of Bandits mod installed. Resubscribe on Steam if you have to.";
