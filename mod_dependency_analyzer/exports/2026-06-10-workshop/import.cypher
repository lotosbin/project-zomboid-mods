MERGE (m:Mod {mod_id: "Horse"}) SET m.name = "Horse Mod", m.version = "1.0.6", m.author = "Horse team", m.pz_version = "42.13.0", m.description = "The Horse mod adds horses to Project Zomboid, allowing the player to care for them, ride them, and much more. A stamina system makes riding feel more realistic. Craft a saddle to make your rides more comfortable, or live the life of a true nomad by adding saddlebags to your horse. If you prefer a rancher’s lifestyle, you can also craft glue from horse hooves, which works similarly to wood glue.";
MERGE (m:Mod {mod_id: "EnergyRoutingSystem"}) SET m.name = "ERS – Energy Routing System", m.version = "1.5", m.author = "DarylMasterGG", m.pz_version = "42.13.0", m.description = "Advanced off-grid energy management system for Project Zomboid. Adds a server-authoritative Energy Routing Controller with real-time UI, solar panels, wind turbines, batteries, energy storage, consumption groups, priority modes, degradation, and maintenance-ready mechanics. Designed for realistic survival gameplay.";
MERGE (m:Mod {mod_id: "LEGION18"}) SET m.name = "LEGION", m.version = "", m.author = "", m.pz_version = "", m.description = "This mod adds Legion Weaponry.";
MERGE (m:Mod {mod_id: "Rollerblades42"}) SET m.name = "", m.version = "", m.author = "", m.pz_version = "42.0", m.description = "Adds rollerblades as footwear with terrain-based speed modifications. Go fast on pavement, slower on grass, and watch out on stairs!";
