MERGE (m:Mod {mod_id: "ArcheryNexus"}) SET m.name = "Archery Nexus [V2]", m.version = "", m.author = "", m.pz_version = "", m.description = "The True Way of the Bow. <LINE> This adds Ash's Primitive Hunting Bow To Zomboid! <LINE> As a framework to be expanded on ! <LINE> This took Hundreds of hours of modding over 4 years to get right. Please do not steal my acheivements. Ask for permission!";
