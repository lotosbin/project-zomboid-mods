MERGE (m:Mod {mod_id: "CleansingRain"}) SET m.name = "Cleansing Rain [B42+MP]", m.version = "0.2.0", m.author = "f3int", m.pz_version = "42.0.0", m.description = "A lightweight, performance-friendly mod that naturally cleans blood and dirt from your character, clothes, weapons, bags, and vehicles when it rains. Build 42 ready.";
MERGE (m:Mod {mod_id: "MoreBuilds"}) SET m.name = "More Builds (B42)", m.version = "42-1.0.1", m.author = "ProjectSky", m.pz_version = "42.0.0", m.description = "Project Zomboid more builds Mod (B42) <BR> author: ProjectSky <BR> Date: September 10, 2015 <BR> Contact: me@imsky.cc";
MERGE (m:Mod {mod_id: "USMilitaryPack"}) SET m.name = "US Military Pack V4", m.version = "", m.author = "", m.pz_version = "42.13.0", m.description = "This is a realistic mod who add military gears with UCP and OCP camouflage pattern and professions...";
MERGE (m:Mod {mod_id: "ToadTraitsDisableSpec"}) SET m.name = "More Traits - Disable Specialization Traits", m.version = "", m.author = "", m.pz_version = "", m.description = "If this submod is enabled, Specialization traits will be disabled.";
MERGE (m:Mod {mod_id: "ToadTraitsDynamic"}) SET m.name = "More Traits - Dynamic Traits", m.version = "", m.author = "", m.pz_version = "42.17", m.description = "If this submod is enabled, Dynamic perks will be enabled. If this mod is disabled, none of the perks in this mod are dynamic. Sandbox settings are present.";
MERGE (m:Mod {mod_id: "ToadTraitsDisablePrepared"}) SET m.name = "More Traits - Disable Prepared Traits", m.version = "", m.author = "", m.pz_version = "", m.description = "If this submod is enabled, Prepared traits will be disabled.";
MERGE (m:Mod {mod_id: "ToadTraits"}) SET m.name = "More Traits", m.version = "", m.author = "", m.pz_version = "42.17", m.description = "Adds additional traits to the game to offer more balanced variety for character creation.";
MERGE (m:Mod {mod_id: "EvolvingTraitsWorldMarkDynamicTraits"}) SET m.name = "Evolving Traits World (ETW) - Mark Dynamic Traits", m.version = "1.0.4", m.author = "", m.pz_version = "42.0", m.description = "Marks traits that can be lost/earned with (D). (P/D) means that they are permanent if picked in character creation, but if not picked they are dynamic and obtainable/losable during the game. Includes support for popular mods. Does not require main mod to be ran, can be run independently.";
MERGE (m:Mod {mod_id: "EasyLaundry"}) SET m.name = "Easy Laundry [B42]", m.version = "42", m.author = "Cosmic", m.pz_version = "42.00", m.description = "Do the laundry efficently.";
MERGE (m:Mod {mod_id: "WolfExtractionQuest"}) SET m.name = "Wolf Extraction Quest", m.version = "0.1", m.author = "Wolfshine", m.pz_version = "42.0.0", m.description = "A configurable endgame quest/mission/challenge. You got a map and an extraction point, you have to find a military walkie talkie to call the helicopter.. this is you mission, this is your hope.";

