MERGE (m:Mod {mod_id: "KRFriOS"}) SET m.name = "KR FRiOS", m.version = "3.1.2", m.author = "D4RK-C0MP4N1", m.pz_version = "42.0.0", m.description = "FriOS offers a range of portable, battery-powered appliances (coolers, fridges, freezers, and stoves), a refrigerated StepVan that keeps food cold in its cargo bed and charges FriOS Batteries from the vehicle battery, and a solar battery charger.";
