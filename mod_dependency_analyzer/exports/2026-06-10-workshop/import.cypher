MERGE (m:Mod {mod_id: "twistbettercharacterinfo"}) SET m.name = "TwisTonFire - Better Character Info", m.version = "1.0", m.author = "TwisTonFire", m.pz_version = "42.19", m.description = "<RGB:1,0.5,0>If you are using Spongies Character Customisation <LINE> Be sure to run my mod after Spongies!";
MERGE (m:Mod {mod_id: "MREfood4213"}) SET m.name = "[B42.15+]More Mre&Millitary food", m.version = "", m.author = "", m.pz_version = "", m.description = "21式自热军粮&食品扩展（更多军粮&军用食物扩展）";
