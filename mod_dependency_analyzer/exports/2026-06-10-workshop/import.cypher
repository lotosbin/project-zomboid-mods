MERGE (m:Mod {mod_id: "DryingRacksFixedB42MP"}) SET m.name = "DryingRacksFixed B42 MP", m.version = "", m.author = "keyreaper", m.pz_version = "42.0", m.description = "A Project Zomboid Build 42 fix for broken drying rack mechanics (Leather and Plants). This is a temporary MP-compatible stop-gap until the passive drying UI is finalized by the developers. Adds \"Dry Leather\" and \"Dry Herbs\" context menu options to drying racks for processing items. Supports all vanilla leather types and various herbs/tobacco with strict rack size validation. Full Multiplayer support.";
