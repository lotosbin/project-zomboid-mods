MERGE (m:Mod {mod_id: "KATTAJ1_Military"}) SET m.name = "KATTAJ1 Military Pack", m.version = "", m.author = "", m.pz_version = "42.15.0", m.description = "This mod adds new Military Armor.";
MERGE (m:Mod {mod_id: "TheShortcut"}) SET m.name = "TheShortcut", m.version = "1.2.6", m.author = "Rocco, Afyrmo", m.pz_version = "42.14.0", m.description = "The Shortcut adds a fast shortcut bar for items, crafting recipes, and building projects. Add what you use most, then double-click to craft/build instantly (when requirements are met), or right-click to jump to the relevant menu with the entry selected — so you spend less time browsing lists and more time playing. <LINE><RGB:0.5,1,0.5> Updated for 42.14+ compatibility and more robust config loading. <LINE><RGB:1,1,1> This is the latest B42 branch in this Workshop item. <LINE><RGB:1,1,1> For older B42 versions, another branch will be shown here.";
MERGE (m:Mod {mod_id: "WestPointExpansionB42"}) SET m.name = "West Point Expansion_B42", m.version = "", m.author = "", m.pz_version = "", m.description = "Expands West Point to include a hospital plus a new urban center east of the rail line called Sandy Ridge adding more civic, residential, commercial and industrial areas to explore and die a grizzly death! Designed for Build 41 by Commander (ww2commander)";
MERGE (m:Mod {mod_id: "BravoItemDetails"}) SET m.name = "Item Details", m.version = "0.0.12", m.author = "Bravo", m.pz_version = "42.13.0", m.description = "Shows information on items when expanded in the inventory panel and Sorting of items in stacks.";
MERGE (m:Mod {mod_id: "04vwTouran"}) SET m.name = "'04 Volkswagen Touran", m.version = "", m.author = "KI5", m.pz_version = "42.13.0", m.description = "This mod adds Volkswagen Touran, compact MPV from 2004";
MERGE (m:Mod {mod_id: "twistresting"}) SET m.name = "TwisTonFire - QoL Modpack", m.version = "1.0", m.author = "", m.pz_version = "42.19", m.description = "A small quality-of-life modpack assembled for personal use. <LINE> <LINE> IMPROVED SOUNDOPTIONS ARE INTEGRATED! <LINE> modOptions fixes ARE INTEGRATED! <LINE> <LINE> The incompatibilities are there on purpose, <LINE> because they’re already bundled somehow in an own version into the pack.";
MERGE (m:Mod {mod_id: "twistrestingmodonly"}) SET m.name = "TwisTonFire - RESTING MOD", m.version = "", m.author = "", m.pz_version = "42.19", m.description = "TwisTonFire’s finest Resting Mod. <LINE> Customize the text and colors so you can clearly see how your character feels. <LINE> It also includes a keybind for sitting down and game speed options.";
MERGE (m:Mod {mod_id: "Constown42"}) SET m.name = "Constown B42", m.version = "", m.author = "", m.pz_version = "", m.description = "Constown is located west of Rosewood on the main highway, so you will find many shops in the city center. There are apartments near the highway, and residences on the outskirts of the town. There is a trailer park nearby. Constown is a city where you want to stay!";
MERGE (m:Mod {mod_id: "ConsolidatedAllFixB42"}) SET m.name = "Consolidate All Fix (B42)", m.version = "1.1", m.author = "phoenix", m.pz_version = "42.13", m.description = "Fixes the \"Consolidate all\" button in the context menu for Build 42. This mod will be removed once the issue is fixed in the vanilla game.";
MERGE (m:Mod {mod_id: "RMSafeHouseUnofficial"}) SET m.name = "B42河畔豪宅非官方版Riverside Mansion Unofficial", m.version = "", m.author = "", m.pz_version = "", m.description = "位于河畔镇左上角，加入了地下射击室和地下储藏室，一楼加了个阅读室，外围增加了个工坊，修改了一些内饰\"Located in the upper-left corner of Riverside; features an underground shooting range and storage basement. A reading room has been added to the first floor, a workshop constructed on the outer perimeter, with various interior decorations modified.\"";
MERGE (m:Mod {mod_id: "DarkWpnSlings"}) SET m.name = "[B42] Dark Weapon Slings", m.version = "", m.author = "phxntom1213", m.pz_version = "", m.description = "Adds rifle slings (as clothing)";
