MERGE (m:Mod {mod_id: "CombatMasteringSkill"}) SET m.name = "Combat Mastering Skill", m.version = "", m.author = "GersonRess", m.pz_version = "", m.description = "Adds a new skill \"Combat Mastering\" that modifies attack speed";
MERGE (m:Mod {mod_id: "radarz"}) SET m.name = "RadarZ", m.version = "1.0.0", m.author = "Alree", m.pz_version = "42.0.0", m.description = "Zombie Radar – Available in All Game Modes!";
MERGE (m:Mod {mod_id: "CleanUI"}) SET m.name = "CleanUI [B42.19+]", m.version = "2.6.7", m.author = "Rocco, Afyrmo", m.pz_version = "42.19.0", m.description = "CleanUI replaces the default inventory, loot, and context UI with a cleaner and more compact layout. <LINE> This is the Build 42.19+ version. <LINE> Includes defensive fixes for invalid repair/fixing definitions, context-menu event hook failures, recent 42.17/42.18/42.19 inventory/UI edge cases, safer long-button texture handling, and Build 42.19 inventory context compatibility. <LINE> There are also variants for builds 42.15.x, 42.13-42.14 and legacy 42.12.x. <LINE> Includes an ESC menu loot-panel visibility workaround for a vanilla B42.19 issue. Controller startup visibility fix.";
MERGE (m:Mod {mod_id: "NepHighBeams"}) SET m.name = "Nepenthe's High Beams 3 (Zomboid 42.9 and later)", m.version = "", m.author = "", m.pz_version = "", m.description = "For Zomboid B42.9 and later";
MERGE (m:Mod {mod_id: "SinkCleanRags_v2"}) SET m.name = "Sink Clean Rags v2", m.version = "1.1", m.author = "EPRock", m.pz_version = "42.4", m.description = "This is an updated version of the Sink Clean Rags mod, fixed for Project Zomboid unstable build 42.4. This will be removed once the original is updated. It supports the new fluid system, ensuring that dirty rags, bandages, denim strips, and leather strips can be cleaned directly at sinks, rain collectors, and portable water containers. Works with both plumbed and unplumbed sources. Thanks to the Original found https://steamcommunity.com/sharedfiles/filedetails/?id=3391344536";
MERGE (m:Mod {mod_id: "66pontiacLeMans"}) SET m.name = "'66 Pontiac LeMans / GTO", m.version = "", m.author = "KI5", m.pz_version = "42.13.0", m.description = "This mod adds Pontiac LeMans and GTO from 1966";
MERGE (m:Mod {mod_id: "SpnCharCustom_CN"}) SET m.name = "Spongie's Character Customisation_CN", m.version = "", m.author = "无聊的栀子", m.pz_version = "", m.description = "Spongie's Character Customisation和Tomb's Player Body - Customisation简体中文汉化翻译（栀子制作）";
MERGE (m:Mod {mod_id: "Spawn Location_CN"}) SET m.name = "[B42] 模组地图出生点汉化 Spawn Location_CN", m.version = "", m.author = "无聊的栀子", m.pz_version = "", m.description = "模组地图出生点汉化（栀子制作） Spawn Location_CN";
MERGE (m:Mod {mod_id: "Frogtown"}) SET m.name = "Frogtown", m.version = "", m.author = "", m.pz_version = "42.0.0", m.description = "Nestled in the lakes of the Doe Valley Forest is one gem of a town! Whether you're hunting for game, or hunting for a sale at the Frogtown Mall, come visit us! With the recent completion of two new condo towers, Frogtown looks forward to a bustling future where its streets are filled with happy people!";
MERGE (m:Mod {mod_id: "AutoLoot_Override"}) SET m.name = "AutoLoot Override", m.version = "", m.author = "", m.pz_version = "", m.description = "This update makes Auto Loot work better and safer. It replaces the main functions with improved versions that check item containers more carefully, avoid duplicate transfers, and handle inventory more smoothly. Everything still works with bags, cars, and furniture. The \"store all\" button stays the same, but now it's smarter behind the scenes. One click, everything gets sorted. Just works better.";
MERGE (m:Mod {mod_id: "ModernStatus"}) SET m.name = "ModernStatus", m.version = "2.4.2", m.author = "Rocco, Afyrmo", m.pz_version = "42.13.0", m.description = "Customizable status HUD with switchable styles, quick actions, and support for many player stats. <LINE><LINE> B42.13+ Variant. <LINE> Legacy variant will be shown here if you downgrade PZ to B42.0.2-B42.12.x.";
MERGE (m:Mod {mod_id: "SpnOpenCloth_CN"}) SET m.name = "[B42] Spongie's Open Jackets ＆ Clothing_CN 简体中文汉化翻译", m.version = "", m.author = "无聊的栀子", m.pz_version = "", m.description = "Spongie's Open Jackets ＆ Spongie's Clothing：Spongie的开放式夹克和衣服简体中文汉化翻译（栀子制作）";
MERGE (m:Mod {mod_id: "H_E_C_U"}) SET m.name = "H.E.C.U.", m.version = "1.7", m.author = "darlak97", m.pz_version = "42.13.0", m.description = "<PUSHRGB:1,1,1><LEFT><SIZE:medium> This mod adds new clothing items related to the H.E.C.U. units, adapted to the B42 mechanics with sound effects and sandbox options.";
MERGE (m:Mod {mod_id: "GanydeBielovzki's Frockin Shirts n Ties"}) SET m.name = "Frockin Shirts & Ties", m.version = "", m.author = "GanydeBielovzki", m.pz_version = "", m.description = "Adds several unreasonably functional shirts and overhauls vanilla ties and bow-ties.";
MERGE (m:Mod {mod_id: "CombatMasteringSkill_CN"}) SET m.name = "Combat Mastering Skill战斗精通技能", m.version = "", m.author = "GersonRess", m.pz_version = "", m.description = "新增“战斗精通”技能，可提升攻击速度，汉化模组Combat Mastering Skill";
