MERGE (m:Mod {mod_id: "CedarHill"}) SET m.name = "Cedar Hill", m.version = "0.1", m.author = "TryHonesty", m.pz_version = "42.0", m.description = "Cedar Hill is a quiet town with polite streets and old stones. But the ground remembers, and some doors were sealed for a reason. <LINE> <LINE> Who knows what the outskirts still whisper to the living.";
