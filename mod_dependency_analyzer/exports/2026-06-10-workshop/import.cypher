MERGE (m:Mod {mod_id: "90bmwE30"}) SET m.name = "'90 BMW 3 Series (E30)", m.version = "", m.author = "KI5", m.pz_version = "42.13.0", m.description = "This mod adds BMW 3 Series (E30) from 1990";
MERGE (m:Mod {mod_id: "Optimal"}) SET m.name = "Every Texture Optimized – Optimal mode", m.version = "4.2.0", m.author = "maceleet", m.pz_version = "42.11.0", m.description = "<RGB:0.71,0.11,0.13> 7500 LIKES – ABSOLUTELY LOSSLESS OPTIMIZATION! <LINE> <RGB:1.0,0.99,0.93> Near-lossless version, the “sweet spot” for those who want the maximum in texture quality and performance. <LINE> The mod supports multiplayer, but you need to install it MANUALLY (before overwriting game files, BE SURE TO MAKE A BACKUP) <LINE> If you encounter a problem please write in: <RGB:0.25,0.83,0.24> [B42] Feedback <LINE>  <LINE> <RGB:0.75,0.64,0.37> P.S: STEAM POINTS and LIKES still the best way to thank me <3";
MERGE (m:Mod {mod_id: "Performance"}) SET m.name = "Every Texture Optimized – Performance mode", m.version = "4.2.0", m.author = "maceleet", m.pz_version = "42.11.0", m.description = "<RGB:0.71,0.11,0.13> 7500 LIKES – ABSOLUTELY LOSSLESS OPTIMIZATION! <LINE> <RGB:1.0,0.99,0.93> Lossy version, for Laptops and Weak PCs where important to squeeze out maximum performance, but at the same time play on decent texture quality. <LINE> The mod supports multiplayer, but you need to install it MANUALLY (before overwriting game files, BE SURE TO MAKE A BACKUP) <LINE> If you encounter a problem please write in: <RGB:0.25,0.83,0.24> [B42] Feedback <LINE>  <LINE> <RGB:0.75,0.64,0.37> P.S: STEAM POINTS and LIKES still the best way to thank me <3";
MERGE (m:Mod {mod_id: "Taylorsville"}) SET m.name = "Taylorsville", m.version = "2.0.4", m.author = "Erika", m.pz_version = "42.0.0", m.description = "Taylorsville is a town located south on the Ohio River, west of West Point. The town is based on the real-life town of Taylorsville, KY.";
